PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lumo
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
TRUST_PROXY=false

# Private attachments are OFF unless explicitly enabled.
# Use a private S3-compatible bucket; never expose these credentials to Android.
MEDIA_ENABLE_UPLOADS=false
MEDIA_BUCKET=
MEDIA_REGION=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
# Optional S3-compatible HTTPS endpoint (for example Cloudflare R2 / MinIO gateway).
MEDIA_ENDPOINT=

# Call signaling and WebRTC audio are OFF unless explicitly enabled in staging.
LUMO_CALL_SIGNALING_ENABLED=false
# Comma-separated private TURN/TURNS URLs only, e.g. turns:turn.example.com:5349?transport=tcp
LUMO_TURN_URLS=
# Coturn REST shared secret: use at least 32 random bytes; never ship it in Android/GitHub.
LUMO_TURN_SECRET=
# Required only for the authenticated scheduled call-metadata cleanup endpoint.
CRON_SECRET=

