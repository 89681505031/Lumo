PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lumo
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
TRUST_PROXY=false

# Private attachments are OFF unless explicitly enabled.
# Use a private S3-compatible bucket; never expose these credentials to Android.
MEDIA_ENABLE_UPLOADS=false
MEDIA_BUCKET=
MEDIA_REGION=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
# Optional S3-compatible HTTPS endpoint (for example Cloudflare R2 / MinIO gateway).
MEDIA_ENDPOINT=

# Call signaling and WebRTC audio are OFF unless explicitly enabled in staging.
LUMO_CALL_SIGNALING_ENABLED=false
# Comma-separated private TURN/TURNS URLs only, e.g. turns:turn.example.com:5349?transport=tcp
LUMO_TURN_URLS=
# Coturn REST shared secret: use at least 32 random bytes; never ship it in Android/GitHub.
LUMO_TURN_SECRET=
# Shared secret for authenticated internal cron endpoints (call cleanup / staging push).
# Use at least 32 random bytes and keep it only in private deployment settings.
CRON_SECRET=

# Push delivery is OFF by default. Android release builds do not link Firebase.
# Enable only on an isolated staging backend after explicit device opt-in tests.
LUMO_PUSH_DELIVERY_ENABLED=false
FIREBASE_PROJECT_ID=
# Firebase Admin credentials must come from Application Default Credentials;
# never paste a service-account private key into this file/repository.

