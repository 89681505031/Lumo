PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lumo
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
TRUST_PROXY=false

# Private direct-message media (optional; disabled until set in hosting secrets)
# MEDIA_BUCKET=private-lumo-media
# MEDIA_REGION=eu-central-1
# MEDIA_ENDPOINT=https://your-s3-compatible-endpoint (omit for AWS S3)
# MEDIA_ACCESS_KEY_ID=configure-in-hosting-secrets
# MEDIA_SECRET_ACCESS_KEY=configure-in-hosting-secrets
