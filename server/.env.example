PORT=3000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/lumo
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
TRUST_PROXY=false

# Private attachments are OFF unless explicitly enabled.
# Use a private S3-compatible bucket; never expose these credentials to Android.
MEDIA_ENABLE_UPLOADS=false
MEDIA_BUCKET=
MEDIA_REGION=
MEDIA_ACCESS_KEY_ID=
MEDIA_SECRET_ACCESS_KEY=
# Optional S3-compatible HTTPS endpoint (for example Cloudflare R2 / MinIO gateway).
MEDIA_ENDPOINT=
# Outstanding unclaimed uploads are additionally bounded in code per account
# (8 reservations / 75 MiB reserved) until they are sent or expire.
# Run GET /internal/media-cleanup from a private scheduler with CRON_SECRET
# to remove expired unclaimed private objects/rows.

# Call signaling and WebRTC audio are OFF unless explicitly enabled in staging.
LUMO_CALL_SIGNALING_ENABLED=false
# Comma-separated private TURN/TURNS URLs only, e.g. turns:turn.example.com:5349?transport=tcp
LUMO_TURN_URLS=
# Coturn REST shared secret: use at least 32 random bytes; never ship it in Android/GitHub.
LUMO_TURN_SECRET=
# Required only for the authenticated scheduled call-metadata cleanup endpoint.
CRON_SECRET=

# Privacy-first generic push is disabled until a dedicated staging Firebase
# project, ADC credentials, HTTPS scheduler and private cron secret are ready.
LUMO_PUSH_DELIVERY_ENABLED=false
FIREBASE_PROJECT_ID=
# Reuse the same private CRON_SECRET only if your staging scheduler policy
# explicitly allows it. Keep at least 32 random bytes and never ship it in APK.
# CRON_SECRET=

